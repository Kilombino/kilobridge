TELEGRAM_TOKEN=
TELEGRAM_CHAT=
LND_CONTAINER=lnd
LND_NETWORK=mainnet
LIMITS_FILE=/srv/bridge-limits/limits.json
# SHA-256 outbound left for other uses of that node; the web stops quoting below it.
RESERVE_SAT=0
DAILY_CAP_SAT=1000000
TIMEZONE=UTC
LANG_MESSAGES=en
SHA_CHAIN=SHA-256
SHA_UNIT=sats SHA-256
OWN_UNIT=sats
PRICE_UNIT=SHA-256 per coin
# USDT value of each swap from NonKYC last prices (ticker of the coin the bridge is paid in; empty = off)
USDT_TICKER_OWN=
USDT_TICKER_SHA=BTC_USDT
# Also tell about this node's channel resizes (splices); 0 turns it off
WATCH_SPLICES=1
