# Where the web listens: PORT behind a reverse proxy or Cloudflare tunnel that sets
# CF-Connecting-IP, TOR_PORT for the onion (headers are not believed there).
PORT=3250
TOR_PORT=3251
LIMITS_FILE=/srv/bridge-limits/limits.json
# What the page calls things.
OPERATOR=Your name
SHA_CHAIN=SHA-256
SHA_UNIT=sats SHA-256
OWN_COIN=BTC
OWN_UNIT=sats
PRICE_UNIT=SHA-256 per coin

# Optional: a kilo-lsp server (inbound channel service) on this machine. When set, the page
# gets a second tab to buy an inbound channel from your node; leave it out for no tab.
#LSP_URL=http://127.0.0.1:3240
#LSP_NAME=My LSP
