[Unit]
Description=Kilobridge web front end
After=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/kilobridge/web/server.js
# The participant code from `lncli bridge code`, decoded to JSON (see the README).
LoadCredential=code:/etc/kilobridge/code.json
EnvironmentFile=/etc/kilobridge/web.env
Environment=BRIDGE_CODE_FILE=%d/code
StateDirectory=kilobridge
Restart=always
RestartSec=5

# Its own throwaway user, a read-only system, and nothing but localhost.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
